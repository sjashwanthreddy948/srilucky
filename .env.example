PORT=3001
SITE_URL=http://localhost:3001
# Set these before running npm run create-admin. Never commit .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional initial contact values. Admin settings take precedence.
PHONE_NUMBER=
WHATSAPP_NUMBER=
# Required on Vercel. Use a persistent database from Vercel Storage/Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
